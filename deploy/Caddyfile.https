(elona_files) {
	root * /srv/elona/current
	encode gzip
	@home path /
	redir @home /elona/ 302
	header Cache-Control "no-cache"
	header X-Content-Type-Options "nosniff"
	file_server
}

pastalapizza.site {
	import elona_files
}

www.pastalapizza.site {
	redir https://pastalapizza.site{uri} 308
}

http://151.241.155.138 {
	import elona_files
}
